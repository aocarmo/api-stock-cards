# Webapp local — configuração (SEM segredos).
# As credenciais AWS NÃO ficam aqui: o app usa a cadeia padrão da AWS
# (variáveis de ambiente AWS_* já exportadas, ou ~/.aws/credentials).

# API remota (api-stock-cards)
MYP_BASE_URL=https://018e6ro2ka.execute-api.us-east-1.amazonaws.com/dev/api/v1

# Tabela de status no DynamoDB (consultada por s3_key) e região
DYNAMO_TABLE=myp-cards-files-dev
AWS_REGION=us-east-1

# Orquestração anti-429
BATCH_SIZE=25
BATCH_INTERVAL_SECONDS=150
POLL_INTERVAL_SECONDS=8
POLL_TIMEOUT_SECONDS=600
MAX_RETRY_ROUNDS=5
SINGLE_THRESHOLD=1
HTTP_TIMEOUT_SECONDS=120

# Servidor local
HOST=127.0.0.1
PORT=8001
DB_PATH=./data/jobs.db
